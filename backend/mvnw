# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
#
# Optional ENV vars
#   MVNW_REPOURL - repo url base for downloading maven distribution
#   MVNW_USERNAME/MVNW_PASSWORD - user and password for downloading maven
#   MVNW_VERBOSE - true: enable verbose log; others: silence the output
# ----------------------------------------------------------------------------

set -e

# Determine the directory of this script
MVNW_DIR="$(cd "$(dirname "$0")" && pwd)"

# Properties file location
WRAPPER_PROPERTIES="$MVNW_DIR/.mvn/wrapper/maven-wrapper.properties"

# Read distribution URL from properties
DISTRIBUTION_URL=$(grep "distributionUrl" "$WRAPPER_PROPERTIES" | cut -d'=' -f2-)
WRAPPER_VERSION=$(grep "wrapperVersion" "$WRAPPER_PROPERTIES" | cut -d'=' -f2-)

# Maven home for downloaded distribution
MAVEN_HOME_DIR="$HOME/.m2/wrapper/dists"
DIST_NAME=$(basename "$DISTRIBUTION_URL" .zip)
MAVEN_HOME="$MAVEN_HOME_DIR/$DIST_NAME"

# Find java
if [ -n "$JAVA_HOME" ]; then
    JAVA_EXE="$JAVA_HOME/bin/java"
else
    JAVA_EXE="$(which java)"
fi

if [ ! -x "$JAVA_EXE" ]; then
    echo "ERROR: JAVA_HOME is not set and 'java' is not in PATH." >&2
    echo "Please set JAVA_HOME to your JDK installation directory." >&2
    exit 1
fi

# Download Maven if not present
if [ ! -f "$MAVEN_HOME/bin/mvn" ]; then
    echo "Downloading Maven from $DISTRIBUTION_URL..."
    mkdir -p "$MAVEN_HOME_DIR"

    DIST_ZIP="$MAVEN_HOME_DIR/$DIST_NAME.zip"

    # Try curl, then wget
    if command -v curl > /dev/null 2>&1; then
        curl -fsSL -o "$DIST_ZIP" "$DISTRIBUTION_URL"
    elif command -v wget > /dev/null 2>&1; then
        wget -q -O "$DIST_ZIP" "$DISTRIBUTION_URL"
    else
        echo "ERROR: Neither curl nor wget found. Cannot download Maven." >&2
        exit 1
    fi

    # Extract
    echo "Extracting Maven..."
    unzip -q -o "$DIST_ZIP" -d "$MAVEN_HOME_DIR"

    # Rename extracted folder
    EXTRACTED_DIR=$(find "$MAVEN_HOME_DIR" -maxdepth 1 -name "apache-maven-*" -type d | head -1)
    if [ -n "$EXTRACTED_DIR" ] && [ "$EXTRACTED_DIR" != "$MAVEN_HOME" ]; then
        mv "$EXTRACTED_DIR" "$MAVEN_HOME"
    fi

    # Clean up
    rm -f "$DIST_ZIP"

    # Verify
    if [ ! -f "$MAVEN_HOME/bin/mvn" ]; then
        echo "ERROR: Maven extraction failed." >&2
        exit 1
    fi

    echo "Maven downloaded successfully."
fi

# Run Maven
exec "$MAVEN_HOME/bin/mvn" "$@" -Dmaven.multiModuleProjectDirectory="$MVNW_DIR"
