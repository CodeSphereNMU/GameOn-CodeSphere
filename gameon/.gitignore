# ============================================================
# GameOn .gitignore
# ============================================================

# === Build Output ===
target/
!**/src/main/**/target/
!**/src/test/**/target/

# === IDE Files ===
.idea/
*.iml
*.iws
.project
.classpath
.settings/
.vscode/
*.swp
*.swo
*~

# === Maven Wrapper ===
# .mvn/, mvnw, and mvnw.cmd are intentionally tracked.

# === Logs ===
logs/
*.log

# === OS Files ===
.DS_Store
Thumbs.db
desktop.ini

# === Environment Files ===
.env
.env.local
.env.*.local

# === Application Generated ===
*.pid
*.seed
