# ============================================================
# GameOn - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ===== Spring Profile =====
# Options: dev, prod, test
SPRING_PROFILES_ACTIVE=dev

# ===== Database Connection =====
# SQL Server connection URL
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=GameOnDb;encrypt=true;trustServerCertificate=true

# Database credentials
DB_USERNAME=gameon_user
DB_PASSWORD=GameOn2026!

# ===== Server =====
# Application port (default: 8080)
SERVER_PORT=8080

# ===== Logging =====
# Log file output directory (default: logs)
LOG_PATH=logs

# ===== Map + Weather + Playability =====
# The venue map (OpenStreetMap/Leaflet), weather forecast (Open-Meteo) and playability
# features use FREE, KEYLESS public APIs, so no API key is required.
# The external calls are made server-side (see MapWeatherController + WeatherService +
# VenueSearchService) and degrade gracefully if the internet is unavailable.
